// ITMDP
window.addEventListener('DOMContentLoaded',function(){
(function(){
	var js = addJS('//www.itmedia.co.jp/js/itmdp_code.js?date=' + cache_query);
	js.addEventListener('load',function(){
		itmdp.largeimage_x_pn = function(article_url){
			var d = document;
			var my_url = d.URL.replace(/(\?|#).*$/,'');
			if(!article_url.match(/\/.+\/(articles|news)\/\d{4}\/\d{2}\/news/)){
				return my_url;
			}
			var article_url_split = article_url.split('/');
			var article_filename = article_url_split[article_url_split.length - 1].replace(/(\_\d{1,})?\.html.+$/,'');
			var my_url_split = my_url.split('/');
			var my_filename = my_url_split[my_url_split.length - 1];
			my_url_split.pop();
			var largeimage_prop10 = my_url_split.join('/') + '/' + article_filename + '/' + my_filename;
			return largeimage_prop10;
		};
		itmdp.x_pn = itmdp.largeimage_x_pn('https://www.itmedia.co.jp/news/articles/2606/10/news122.html#l_my_0610apple01.jpg');
		if(pc2sp == 'pcv'){
			itmdp.x_dp = 'root,itm,news,article,exp_img';
			itmdp.x_ch = 'news';
			itmdp.x_sch = 'news,article';
		}else{
			itmdp.x_dp = 'root,smartphone,news,article,exp_img';
			itmdp.x_ch = 'news_spv';
			itmdp.x_sch = 'news_spv,article';
			itmdp.x_p22 = 'news_spv_article';
		}
		itmdp.x_e = 'event3';
		var itm_pageview = itmdp.pageview();
	},false);
})();
},false);

