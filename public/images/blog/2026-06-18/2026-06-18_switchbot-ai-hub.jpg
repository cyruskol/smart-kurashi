bot_06\",\"caption\":\"Screenshot: 奥旅男\",\"source\":\"\",\"description\":\"\",\"file_size\":841071,\"height\":1132,\"href\":\"\",\"mime\":\"JPEG\",\"name\":\"260411_switchbot_06\",\"previewPath\":\"https://assets.media-platform.com/gizmodo/original/images/2026/04/11/260411_switchbot_06.jpg\",\"title\":\"\",\"webpath\":\"https://assets.media-platform.com/gizmodo/dist/images/2026/04/11/260411_switchbot_06.jpg\",\"width\":2000}}},\"14\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"data\":{\"href\":\"http://wapi.gizmodo.jp/redirect.php?rid=96051\",\"target\":\"_blank\"}},\"15\":{\"type\":\"FIGURE\",\"mutability\":\"IMMUTABLE\",\"data\":{\"type\":\"INSERT_BLOCK\",\"target\":\"FIGURE\",\"data\":{\"alt\":\"260409_switchbot_19\",\"caption\":\"GIF: 奥旅男\",\"source\":\"\",\"description\":\"\",\"file_size\":9990559,\"height\":360,\"href\":\"\",\"mime\":\"GIF\",\"name\":\"260409_switchbot_19\",\"previewPath\":\"https://assets.media-platform.com/gizmodo/original/images/2026/04/09/260409_switchbot_19.GIF\",\"title\":\"\",\"webpath\":\"https://assets.media-platform.com/gizmodo/dist/images/2026/04/09/260409_switchbot_19.GIF\",\"width\":640}}},\"16\":{\"type\":\"FIGURE\",\"mutability\":\"IMMUTABLE\",\"data\":{\"type\":\"INSERT_BLOCK\",\"target\":\"FIGURE\",\"data\":{\"alt\":\"260414_switchbot_03\",\"caption\":\"Photo: 小原啓樹\",\"source\":\"\",\"description\":\"\",\"file_size\":2029267,\"height\":1334,\"href\":\"\",\"mime\":\"JPEG\",\"name\":\"260414_switchbot_03\",\"previewPath\":\"https://assets.media-platform.com/gizmodo/original/images/2026/04/14/260414_switchbot_03.jpg\",\"title\":\"\",\"webpath\":\"https://assets.media-platform.com/gizmodo/dist/images/2026/04/14/260414_switchbot_03.jpg\",\"width\":2000}}},\"17\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"data\":{\"href\":\"http://wapi.gizmodo.jp/redirect.php?rid=96052\",\"target\":\"_blank\"}},\"18\":{\"type\":\"FIGURE\",\"mutability\":\"IMMUTABLE\",\"data\":{\"type\":\"INSERT_BLOCK\",\"target\":\"FIGURE\",\"data\":{\"alt\":\"260414_switchbot_04\",\"caption\":\"Photo: 小原啓樹\",\"source\":\"\",\"description\":\"\",\"file_size\":2118726,\"height\":1333,\"href\":\"\",\"mime\":\"JPEG\",\"name\":\"260414_switchbot_04\",\"previewPath\":\"https://assets.media-platform.com/gizmodo/original/images/2026/04/14/260414_switchbot_04.jpg\",\"title\":\"\",\"webpath\":\"https://assets.media-platform.com/gizmodo/dist/images/2026/04/14/260414_switchbot_04.jpg\",\"width\":2000}}},\"19\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"data\":{\"href\":\"http://wapi.gizmodo.jp/redirect.php?rid=96053\",\"target\":\"_blank\"}},\"20\":{\"type\":\"FIGURE\",\"mutability\":\"IMMUTABLE\",\"data\":{\"type\":\"INSERT_BLOCK\",\"target\":\"FIGURE\",\"data\":{\"alt\":\"260414_switchbot_05\",\"caption\":\"Photo: 小原啓樹\",\"source\":\"\",\"description\":\"\",\"file_size\":1961845,\"height\":1334,\"href\":\"\",\"mime\":\"JPEG\",\"name\":\"260414_switchbot_05\",\"previewPath\":\"https://assets.media-platform.com/gizmodo/original/images/2026/04/14/260414_switchbot_05.jpg\",\"title\":\"\",\"webpath\":\"https://assets.media-platform.com/gizmodo/dist/images/2026/04/14/260414_switchbot_05.jpg\",\"width\":2000}}},\"21\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"data\":{\"href\":\"http://wapi.gizmodo.jp/redirect.php?rid=96054\",\"target\":\"_blank\"}},\"22\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"data\":{\"href\":\"http://wapi.gizmodo.jp/redirect.php?rid=96055\",\"target\":\"_blank\"}},\"23\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"data\":{\"href\":\"http://wapi.gizmodo.jp/redirect.php?rid=96056\",\"target\":\"_blank\"}},\"24\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"data\":{\"href\":\"http://wapi.gizmodo.jp/redirect.php?rid=96057\",\"target\":\"_blank\"}}},\"blocks\":[{\"key\":\"99m5c\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"fqoiq\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"aahfu\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"61nmo\",\"text\":\"これまでの「ハブ」とは別物です。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"1egak\",\"text\":\"SwitchBot（スイッチボット）の代表的製品である「ハブ3」「ハブ2」「ハブミニ」。これらは「エアコンやテレビなどの赤外線リモコンを登録して、スマホで操作できるようにするスマートリモコン」という認識の方が多いのでは。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":18,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"2scpg\",\"text\":\"しかし、実をいうと「ハブ」という名前には「スマートホームの中枢」という意味が込められていて、単なるスマートリモコンを超えたデバイスであるというのがSwitchBotの考え方なのです。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":21,\"length\":10,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"es8nj\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"3cg2g\",\"text\":\"今回紹介する「AIハブ」は、SwitchBotが「ハブ」という名前に込めた「スマートホームの中枢」を体現する製品と言えます。これまでのスマートホーム製品にはなかった機能を備えていて、家の中の出来事を「理解して、言葉にして、動きにつなげる」存在になっています。これらが実際の暮らしの中でどう便利さにつながるのか、早速見ていきましょう。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":7,\"length\":4,\"style\":\"BOLD\"},{\"offset\":100,\"length\":18,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":7,\"length\":4,\"key\":1}],\"data\":{}},{\"key\":\"pj67\",\"text\":\"VLM（視覚言語モデル）が出来事を文章にしてくれる\",\"type\":\"header-two\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"2682a\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":2}],\"data\":{}},{\"key\":\"3u62n\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"c8f2n\",\"text\":\"まず「AI」というワードが気になりますよね。「AIハブ」にはVLM（視覚言語モデル）というAIモデルが搭載されています。ChatGPTやClaudeのようなテキストデータのパターンや文脈を学習するLLM（大規模言語モデル）に対し、VLMは画像や映像などの視覚データとテキストデータの関係を学習するAIモデルです。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":23,\"length\":4,\"style\":\"BOLD\"},{\"offset\":30,\"length\":12,\"style\":\"BOLD\"},{\"offset\":115,\"length\":38,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":23,\"length\":4,\"key\":3}],\"data\":{}},{\"key\":\"edvm6\",\"text\":\"これがスマートホームのハブに搭載されたらどんなことができるようになるかというと……\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"7qd38\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":4}],\"data\":{}},{\"key\":\"45puo\",\"text\":\"こんな感じ。我が家ではペットの見守り用にSwitchBotの「見守りカメラPlus 3MP」を設置しているのですが、そのカメラがとらえた映像を「AIハブ」が理解して文章にしてくれるのです。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":71,\"length\":19,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"qg2b\",\"text\":\"見守りカメラの映像だけだとぱっと見で理解しにくい状況も、こうして書いてくれると理解しやすい。家の中で起きていることが分かりやすくなります。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":46,\"length\":22,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"7afon\",\"text\":\"その瞬間をとらえた画像と相まって、絵日記みたいでいい感じ。全部保存したくなります。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":17,\"length\":23,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"5l2e1\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":5}],\"data\":{}},{\"key\":\"gsu9\",\"text\":\"さらに便利だなと思ったのが「AIできごとログ」。「AIハブ」のアウトプットがログになっているわけですが、これのおかげで外出中にペットがどう過ごしていたかを効率的に振り返られるようになりました。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":59,\"length\":28,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"2igcf\",\"text\":\"従来のカメラだと録画データを見返さなければならなくて結構時間を取られていたのですが、この形なら流し読みができるしキーワード検索も可能になります。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":47,\"length\":19,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"572mu\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"9cb7i\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":6}],\"data\":{}},{\"key\":\"9vhn7\",\"text\":\"さらに「AIまとめ」として1日の出来事を要約してくれる機能もあるので、その日に起きたことをざっくり知りたいときはこちらをチェックすればよい感じです。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":13,\"length\":14,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"brt8r\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":7}],\"data\":{}},{\"key\":\"5ijim\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":8}],\"data\":{}},{\"key\":\"b01hq\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"5of7m\",\"text\":\"もう一つ「AIハブ」のユニークなポイントとして、カメラごとに役割を設定できる機能があります。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":24,\"length\":14,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"pnv1\",\"text\":\"「見守り担当」「警備担当」「ペット担当」「全般」の4つが用意されていて、「見守り担当」「警備担当」では対象人物の設定も可能。登録した人物を顔認識してくれるので、その人の行動を発動条件にしたオートメーションの設定もできます。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":84,\"length\":21,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"5jvl7\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":9}],\"data\":{}},{\"key\":\"27rev\",\"text\":\"我が家では「ペット担当」の「ペットがごはんを食べている」を発動条件として、検知したら僕のところへ「猫がごはんを食べました」というプッシュ通知がくるようにオートメーションを設定しています。外出中にこの通知を受け取ると、ほっこり安心できます。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":14,\"length\":13,\"style\":\"BOLD\"},{\"offset\":49,\"length\":11,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"c2nqa\",\"text\":\"OpenClaw対応。AIエージェントとの組み合わせで何ができる？\",\"type\":\"header-two\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"aesid\",\"text\":\"「AIハブ」はOpenClawがローカルで動作します。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":1,\"length\":4,\"style\":\"BOLD\"},{\"offset\":7,\"length\":20,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":1,\"length\":4,\"key\":10}],\"data\":{}},{\"key\":\"d2m3t\",\"text\":\"ローカルのAIエージェントを使ってみたいけど、別途PCを用意したり環境構築したりするのはハードルが高いなぁと感じていたので、ローコストで手軽に導入できるのが、まずうれしい。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":62,\"length\":14,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"6dllc\",\"text\":\"そして、「AIハブ」にOpenClawを組み合わせると、自然な会話で家がコントロールできるようになるのですよ。これは体験としてかなり新鮮です。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":28,\"length\":17,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"btq34\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":11}],\"data\":{}},{\"key\":\"29n36\",\"text\":\"早速やってみました。SwitchBotのサイトに掲載されているマニュアルに沿って設定。設定方法を解説する動画も用意されています。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":10,\"length\":26,\"key\":12}],\"data\":{}},{\"key\":\"9kudc\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":13}],\"data\":{}},{\"key\":\"ad9m1\",\"text\":\"WhatsAppでOpenClawとやり取りできるようにしました。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":22,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"ermhi\",\"text\":\"自分の電話番号宛に指令を送るとOpenClawが応えてくれる設定になっていて、僕が「AIハブ」に登録している「ハブミニ」経由でテレビやエアコンを操作してくれます。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":63,\"length\":11,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"744uj\",\"text\":\"注目してほしいのは、「蒸し暑い」という曖昧な表現に対して「温度を下げる」「ファンを強くする」という対応をしてくれていること。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":11,\"length\":4,\"style\":\"BOLD\"},{\"offset\":29,\"length\":6,\"style\":\"BOLD\"},{\"offset\":37,\"length\":8,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"1pmi2\",\"text\":\"さらにしてほしいことがあったらOpenClawに会話でリクエスト可能です。例えば「『寝ます』と伝えたらテレビとエアコンをオフにしてください」と伝えておけば、今後はそのとおりに動いてくれます。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":15,\"length\":17,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"4ngcr\",\"text\":\"もちろん、普通にニュースの要約なんかもお願いできますよ。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":5,\"length\":10,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"7tkub\",\"text\":\"やはり自然な会話でやり取りできるのは便利だし感覚的。これまでのスマートホームと大きく違う体験です。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"3hcp1\",\"text\":\"オートメーションはローカル処理＝速い\",\"type\":\"header-two\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"ci0if\",\"text\":\"「AIハブ」はハードウェアとしても従来の「ハブ」シリーズから進化しています。一番の特徴は、オートメーションがクラウド処理からローカル処理になったことでしょう（\u003csmall\u003e※VLMを用いたAI機能全般はクラウド処理に依存します\u003c/small\u003e）。これにより応答速度が向上しました。動画を見てください。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":1,\"length\":4,\"style\":\"BOLD\"},{\"offset\":45,\"length\":27,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":1,\"length\":4,\"key\":14}],\"data\":{}},{\"key\":\"aeje3\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":15}],\"data\":{}},{\"key\":\"1gjj0\",\"text\":\"左が「AIハブ」、右が「ハブミニ」で組んだオートメーションです。どちらも「開閉センサー」を開閉すると「ボット」がカチッと動くオートメーションですが、ローカル処理の「AIハブ」の方がクラウド処理の「ハブミニ」よりも応答が速いのが分かります。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"8916h\",\"text\":\"スマートホームは便利だけど微妙なタイムラグが気になるんだよねと感じていた人にはぜひ「AIハブ」を体験してもらいたいですね。認識が変わると思います。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":13,\"length\":44,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"2l2us\",\"text\":\"データもローカルに保存＝安全\",\"type\":\"header-two\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"f74vo\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":16}],\"data\":{}},{\"key\":\"27f93\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"b61ac\",\"text\":\"「AIハブ」は、録画データをクラウドにアップロードせず、ローカルに保存します。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":1,\"length\":4,\"style\":\"BOLD\"},{\"offset\":8,\"length\":27,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":1,\"length\":4,\"key\":17}],\"data\":{}},{\"key\":\"6u9n2\",\"text\":\"これは「スマートホームに関心はあるけど、家の中の映像が外に出るのは不安…」と感じていた人にとってもうれしい機能ではないでしょうか。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"d3l6n\",\"text\":\"内蔵ストレージを32GB備えていて、最大1TBのmicroSDや最大16TBの外付けHDD、NASストレージにも対応しています。クラウドストレージのランニングコストがかからないのもメリットですね。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"3g4go\",\"text\":\"先ほど書いた顔認識情報もローカルに保存されますので、例えばインターホンのカメラがとらえたのが家族かそれ以外の人物かを判別するのもローカル処理で速いです。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"cbcti\",\"text\":\"デュアルバンドWi-FiやHome Assistantに対応\",\"type\":\"header-two\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"7mn\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":18}],\"data\":{}},{\"key\":\"52at3\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"70b8a\",\"text\":\"「AIハブ」は接続性や拡張性の面でもハイスペックで、「スマートホームの中枢」としての信頼感が大きいです。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":1,\"length\":4,\"style\":\"BOLD\"},{\"offset\":26,\"length\":19,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":1,\"length\":4,\"key\":19}],\"data\":{}},{\"key\":\"7pt9k\",\"text\":\"例えば、「ハブ」シリーズで初めて2.4GHz／5GHzデュアルバンドWi-Fiに対応したことは、見えない部分ですがかなり効いています。壁や障害物に強い2.4GHzと、通信干渉に強い5GHzを併用することで、接続がより安定するし応答の遅れも抑えられるのですよね。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":16,\"length\":26,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"7af0j\",\"text\":\"Home Assistantゲートウェイ機能も搭載されました。Home Assistant Core Containerを本体に内蔵し、Home AssistantのBluetooth／Wi-Fi対応スマートデバイスをUSBドングルなしで直接接続可能。また、スマートデバイス間の通信に利用される省電力の無線技術BLE（Bluetooth Low Energy）にも対応していて、Bluetooth通信距離は最大200m、壁越しや遠くの機器とも安定してつながります。本機を介して最大30台のSwitchBotサブデバイスをMatterに接続可能なのも頼もしい。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":25,\"style\":\"BOLD\"},{\"offset\":155,\"length\":29,\"style\":\"BOLD\"},{\"offset\":238,\"length\":33,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"4ci15\",\"text\":\"さらに、RTSP対応によって他社製カメラとの連携ができることもポイントでしょう。既に自宅にスマートカメラを設置しているという人も、その資産を生かしながら「AIハブ」が導入できます。「AIハブ」のファームウェアV3.0以降では、他社製RTSPカメラのリアルタイム映像を外部ディスプレイに表示することにも対応しています。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":4,\"length\":24,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"7pkbv\",\"text\":\"僕たちの暮らしも大きくアップデートされそう\",\"type\":\"header-two\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"b1jji\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":20}],\"data\":{}},{\"key\":\"a7blh\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"al34k\",\"text\":\"「AIハブ」の価格は3万9980円（税込）。VLMによるAI機能は、サブスクリプション制の有料サービスで月額1680円（税込）です。最初の1カ月間は無料ですよ。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":1,\"length\":4,\"style\":\"BOLD\"},{\"offset\":66,\"length\":10,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":1,\"length\":4,\"key\":21}],\"data\":{}},{\"key\":\"5o8vd\",\"text\":\"VLMによるAI機能を利用するにはカメラ製品と併用する必要があり、SwitchBotでは「見守りカメラPlus 5MP」「見守りカメラPlus 3MP」「スマートテレビドアホン」の3モデルが対応。先述したように他社製のRTSPカメラも対応しています。接続可能台数は「AIハブ」1台につき最大8台です。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"8p5nc\",\"text\":\"また、「AIハブ」は赤外線を発射する機能を備えていないので、エアコンやテレビなどの赤外線リモコンを制御したい場合は「ハブ3」「ハブ2」「ハブミニ」のいずれかと併用してください。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"n450\",\"text\":\"進化した「スマートホームの中枢」、ぜひ体験を。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":16,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"1oes3\",\"text\":\"＼お得なキャンペーン情報／\",\"type\":\"blockquote\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":13,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"b07mh\",\"text\":\"ここまで読んで「AIハブ」に興味津々のあなた。お得なキャンペーンがあるので、ぜひこの機会にゲットしてください。通常価格3万9980円のところ、20％オフの3万1984円になります。\",\"type\":\"blockquote\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":55,\"length\":29,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"91cft\",\"text\":\"Amazon：2026年4月21日～5月4日\u003cbr\u003e公式サイト：2026年4月21日～4月30日\",\"type\":\"blockquote\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":6,\"style\":\"BOLD\"},{\"offset\":26,\"length\":5,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":0,\"length\":6,\"key\":22},{\"offset\":26,\"length\":5,\"key\":23}],\"data\":{}},{\"key\":\"1ufuo\",\"text\":\"さらにお得なクーポンもご用意。Amazon／公式サイト共通で使えます。\",\"type\":\"blockquote\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":6,\"length\":8,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"78bjd\",\"text\":\"コード：26AHGIGA\u003cbr\u003e割引額：500円\u003cbr\u003e利用期間：2026年4月21日9:00 ～ 2026年5月4日23:59:59\",\"type\":\"blockquote\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"bdfdt\",\"text\":\"\u003csmall\u003eSource: SwitchBot\u003c/small\u003e\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":15,\"length\":9,\"key\":24}],\"data\":{}},{\"key\":\"2qb5m\",\"text\":\"\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}]}","meta":{"seo_title":"","description":"","canonical":"","header_script":"","footer_script":"","source_link":"","source_author":""},"ogp_image":{"url":"https://media.loom-app.com/mpp/gizmodo/dist/images/2026/04/14/260414_switchbot_06.jpg"},"thumbnail":{"image":{"url":"https://media.loom-app.com/mpp/gizmodo/dist/images/2026/04/14/260414_switchbot_06.jpg","meta":{"width":2000,"height":1125}},"caption":"Photo: 小原啓樹","source":"","alt":"260414_switchbot_06"},"collections":[{"slug":"switchbot","title":"SWITCHBOT株式会社","type":"DEFAULT","main_image":null,"sponsored":{"by":[]},"parent":{"slug":"sponsored_name"},"children":[]},{"slug":"product","title":"PRODUCT","type":"DEFAULT","main_image":null,"sponsored":{"by":[]},"parent":{"slug":"category"},"children":[]},{"slug":"sponsored","title":"Sponsored","type":"DEFAULT","main_image":null,"sponsored":{"by":[]},"parent":{"slug":"article_type"},"children":[]}],"tags":[{"slug":"smart_home","name":"スマートホーム"}],"collaborators":[{"name":"奥旅男","slug":"okutabio","job_title":"GIZMODOライター","description":null,"image_url":""}],"product_name":{"value":""},"official_label":{"value":""},"official_url":{"value":""}},"adSpaceData":{"is_active":true,"id":"66650f23-2d03-402f-bb6b-275e45be4799","title":"Article Page (Default)","settings":[{"name":"pc","tam_timeout":1500,"prebid_timeout":2000,"slots":[{"is_prebid":true,"title":"/15055520/pc_gizmodo_1st_splashbox","div_id":"gizmodo2017_normal-2","size":["[\"300\",\"250\"]"],"tam_size":["[\"300\",\"250\"]"],"lazyload_tam_size":[]},{"is_prebid":true,"title":"/15055520/pc_gizmodo_article_in_t