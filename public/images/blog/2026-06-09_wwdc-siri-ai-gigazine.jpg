    const t = Math.floor(Date.now() / 1000);
    const s = "T69RWadnZ5mkI+RZAZvJcuSUGv1XGJLvJu2WNrHXYLHfWy7REFBQKg6qv1C923H80EanY/h3aek23P6y8t8Tufjq4rSWLiVy+y/uTtWoLyk=";
    const req_data = {
      "addr": addr,
      "t": t,
      "s": s
    }
    donateDialogSubmitButton.disabled = true;
    var xhr = new XMLHttpRequest();
    xhr.open('POST', '/gsc/donate_remind_mail');
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.onreadystatechange = function() {
      if (xhr.readyState === XMLHttpRequest.DONE) {
        if (xhr.status === 200) {
          const resp_data = JSON.parse(xhr.responseText);
          if (!resp_data || resp_data.code !== 200 || resp_data.msg !== '') {
            // 送信失敗時の処理
            fnc_err(resp_data.msg);
          }
          else {
            // 送信完了時の処理
            fnc_sent();
          }
        }
        else {
          // 送信失敗時の処理
          fnc_err('通信エラーが発生しました。');
        }
      }
    };
    xhr.onerror = function() {
      // 送信失敗時の処理
      fnc_err('通信エラーが発生しました。');
    };
    xhr.send(JSON.stringify(req_data));
  });
})()
